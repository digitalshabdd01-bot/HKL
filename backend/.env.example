# These are examples; settings read environment variables, not this file automatically.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Production requires a persistent MySQL or PostgreSQL connection:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# MySQL alternative (install requirements-mysql.txt or use Dockerfile.mysql):
# DATABASE_URL=mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/hkl
# MYSQL_SSL_CA=/etc/secrets/ca.pem
